{
  "name": "huiyao",
  "private": true,
  "version": "2.0.3",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "build:macos:arm64": "./scripts/build-macos-arm64.sh",
    "package:macos": "./scripts/package-macos-arm64.sh",
    "check": "./scripts/check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec:list": "openspec list",
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "spec:view": "openspec view",
    "verify:frontend-dist": "node --no-warnings --experimental-vm-modules scripts/verify-frontend-dist.mjs",
    "verify:lockfile": "node scripts/verify-package-lock.mjs",
    "verify:release": "./scripts/verify-release.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@tauri-apps/api": "^2.11.1",
    "partial-json": "^0.1.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.7.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  }
}
